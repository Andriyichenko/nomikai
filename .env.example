# Supabase (Project Settings → API). The anon/publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the site (used in notification mails, robots.txt and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for the "決定" notification mail (optional — without it the checkbox is disabled)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Server-only: lets the server send mails to everyone / process one-click join links / run the morning reminder.
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=
# Signs the "参加する / 見送る" links in invitation mails
EMAIL_LINK_SECRET=
# Protects /api/cron/day-of (sent as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
